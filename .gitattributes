# Normalize all text files to LF in the repository (silences CRLF warnings on Windows).
* text=auto eol=lf

# Treat common data/figure binaries as binary so Git never line-ending-mangles them.
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
*.parquet binary
*.zip  binary
*.gz   binary
*.xlsx binary

# Raw data is immutable and sha256-anchored in PROVENANCE (CLAUDE.md §2.6/§6).
# Store exact bytes — never normalize line endings, or checkout hashes won't match.
data/raw/** -text
