# Required secret/config NAMES only — never put real values in this file.
# Copy to `.env` (which is gitignored) and fill values locally.
# CLAUDE.md §10: keys are read from the environment only; never hardcoded,
# committed, or printed to logs.
#
# Verify each provider's current auth requirement and official key-request page
# at fetch time (Phase 2/3) — do not assume an endpoint or key is needed until
# confirmed live.

# SEC EDGAR requires no API key, but requests must send a descriptive
# User-Agent that includes a contact email (per SEC fair-access policy).
SEC_EDGAR_USER_AGENT=

# FRED (St. Louis Fed) — API key required (obtain from the provider's official docs).
FRED_API_KEY=

# EIA (US Energy Information Administration) — API key required.
EIA_API_KEY=

# Add further key names here only as sources are confirmed in Phase 2.
